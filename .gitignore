# Symbolication related
app.*.symbols

# Obfuscation related
app.*.map.json

# Android Studio will place build artifacts here
/android/app/debug
/android/app/profile
/android/app/release

# Local server environment file (DO NOT COMMIT)
/server/.env

# Ignore project root env file that may contain secrets
/.env
 
# Backend local env and virtualenv
/backend/.env
/backend/.venv/

# Large ML models (Vosk, TFLite, etc. — too large for source control)
/backend/models/vosk_*/
/backend/models/injury_detector.tflite
/backend/models/labels.txt

