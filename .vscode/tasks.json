{
	"version": "2.0.0",
	"tasks": [
		{
			"label": "Flutter Run (Debug Mode)",
			"type": "shell",
			"command": "flutter run",
			"args": [],
			"isBackground": false,
			"problemMatcher": [],
			"group": "build"
		},
		{
			"label": "Emergency AI: Run Tests",
			"type": "shell",
			"command": "node",
			"args": ["src/test-emergency.js"],
			"group": {
				"kind": "test",
				"isDefault": true
			},
			"presentation": {
				"reveal": "always",
				"panel": "new"
			},
			"problemMatcher": []
		},
		{
			"label": "Emergency AI: Health Check",
			"type": "shell",
			"command": "node",
			"args": ["-e", "require('./src/emergency-ai-client').healthCheck()"],
			"presentation": {
				"reveal": "always",
				"panel": "new"
			},
			"problemMatcher": []
		},
		{
			"label": "Emergency AI: Quick Test",
			"type": "shell",
			"command": "node",
			"args": [
				"-e",
				"const client = new (require('./src/emergency-ai-client'))(); client.sendEmergency('Test emergency', {language: 'en'}).then(r => console.log(r));"
			],
			"presentation": {
				"reveal": "always",
				"panel": "new"
			},
			"problemMatcher": []
		}
	]
}