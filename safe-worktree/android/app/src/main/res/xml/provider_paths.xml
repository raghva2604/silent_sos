<?xml version="1.0" encoding="utf-8"?>
<!-- res/xml/provider_paths.xml -->
<!-- FileProvider paths configuration for CameraX and file sharing -->
<paths xmlns:android="http://schemas.android.com/apk/res/android">
    <!-- Cache directory for temporary files -->
    <cache-path name="cache" path="/" />

    <!-- Files directory for app-specific files -->
    <files-path name="files" path="/" />

    <!-- External files directory (if needed) -->
    <external-files-path name="external_files" path="/" />

    <!-- Shared documents directory -->
    <files-path name="shared_docs" path="shared_docs/" />

    <!-- App-specific cache for images/videos -->
    <cache-path name="media_cache" path="media/" />
</paths>
