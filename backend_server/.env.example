# Example environment variables for Silent SOS backend
PORT=3000

# Gmail SMTP (App password)
SMTP_HOST=smtp.gmail.com
SMTP_PORT=587
SMTP_SECURE=false
SMTP_USER=your.email@gmail.com
SMTP_PASS=YOUR_APP_PASSWORD_HERE
EMAIL_FROM="SOS App <your.email@gmail.com>"

# Twilio (optional - leave blank until you enable)
TWILIO_SID=
TWILIO_TOKEN=
TWILIO_FROM=
